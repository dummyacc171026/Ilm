شِّتَاءِ وَالصَّيْفِ ۝ فَلْيَعْبُدُوا رَبَّ هٰذَا الْبَيْتِ ۝ الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ":[[106,1],[106,2],[106,3],[106,4]],"اللّٰهُ لَا إِلٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ":[[2,255]],"يسٓ ۝ وَالْقُرْآنِ الْحَكِيمِ":[[36,1],[36,2]],"تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ":[[67,1]],"اللّٰهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ":[[24,35]],"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ":[[55,13]],"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ":[[99,7]],"لَا إِلٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ":[[21,87]],"أُولُو الْعَزْمِ":[[46,35]],"رَبَّنَا تَقَبَّلْ مِنَّا":[[2,127]],"فَصَبْرٌ جَمِيلٌ":[[12,18]],"أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ":[[21,83]],"إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً":[[2,30]],"الْهُدْهُد":[[27,20]],"مَرْيَم":[[3,42]],"الْمَسِيح":[[4,171]],"وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِلْعَالَمِينَ":[[21,107]],"رَبَّنَا ظَلَمْنَا أَنْفُسَنَا وَإِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ":[[7,23]],"لَا تَحْزَنْ إِنَّ اللّٰهَ مَعَنَا":[[9,40]],"جَاءَ الْحَقُّ وَزَهَقَ الْبَاطِلُ":[[17,81]],"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ":[[68,4]],"فَلَا تَقُلْ لَهُمَا أُفٍّ":[[17,23]],"رَبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا":[[17,24]],"وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً":[[30,21]],"وَبِالْوَالِدَيْنِ إِحْسَانًا":[[17,23]],"إِنَّا لِلّٰهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ":[[2,156]],"حَسْبُنَا اللّٰهُ وَنِعْمَ الْوَكِيلُ":[[3,173]],"رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ":[[2,201]],"رَبَّنَا ظَلَمْنَا أَنْفُسَنَا":[[7,23]],"رَبِّ زِدْنِي عِلْمًا":[[20,114]],"سُبْحَانَ الَّذِي سَخَّرَ لَنَا هٰذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ":[[43,13]],"رَبِّ اجْعَلْنِي مُقِيمَ الصَّلَاةِ وَمِنْ ذُرِّيَّتِي، رَبَّنَا وَتَقَبَّلْ دُعَاءِ":[[14,40]],"بِسْمِ اللّٰهِ":[[1,1]],"حَلَال":[[2,168]],"لَا إِكْرَاهَ فِي الدِّينِ":[[2,256]],"لَا تَقْنَطُوا مِنْ رَحْمَةِ اللّٰهِ":[[39,53]],"لَئِنْ شَكَرْتُمْ لَأَزِيدَنَّكُمْ":[[14,7]],"أَلَا بِذِكْرِ اللّٰهِ تَطْمَئِنُّ الْقُلُوبُ":[[13,28]],"قَدْ أَفْلَحَ مَنْ زَكَّاهَا":[[91,9]],"قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللّٰهِ":[[39,53]],"وَأَقِمِ الصَّلَاةَ لِذِكْرِي":[[20,14]],"الْجُمُعَة":[[62,9]],"وَمَا خَلَقْتُ الْجِنَّ وَالْإِنْسَ إِلَّا لِيَعْبُدُونِ":[[51,56]],"أَلَسْتُ بِرَبِّكُمْ قَالُوا بَلَىٰ":[[7,172]],"الْعَزِيز":[[59,23]],"الْجَبَّار":[[59,23]],"الْمُتَكَبِّر":[[59,23]],"الْبَارِئ":[[59,24]],"الْمُصَوِّر":[[59,24]],"الْغَفَّار":[[20,82]],"الْقَهَّار":[[13,16]],"الْوَهَّاب":[[3,8]],"الْفَتَّاح":[[34,26]],"اللَّطِيف":[[67,14]],"الْخَبِير":[[67,14]],"الْعَظِيم":[[2,255]],"الْعَلِيّ":[[2,255]],"الْكَرِيم":[[82,6]],"الْحَقّ":[[22,6]],"الْوَكِيل":[[3,173]],"الْقَوِيّ":[[22,40]],"الْمَتِين":[[51,58]],"الْمُحْيِي":[[30,50]],"التَّوَّاب":[[2,37]],"الرَّءُوف":[[2,143]],"الْغَنِيّ":[[35,15]],"النُّور":[[24,35]],"الْمُؤْمِن":[[59,23]],"الْمُهَيْمِن":[[59,23]],"فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ":[[2,186]],"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا":[[94,5],[94,6]],"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ ارْجِعِي إِلَىٰ رَبِّكِ رَاضِيَةً مَرْضِيَّةً":[[89,27],[89,28]],"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ":[[94,1]],"لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ":[[12,92]],"الْحَوَارِيُّونَ":[[3,52]],"رَبِّ اغْفِرْ لِي وَلِوَالِدَيَّ":[[71,28]],"رَبِّ اشْرَحْ لِي صَدْرِي وَيَسِّرْ لِي أَمْرِي":[[20,25],[20,26]],"رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ":[[28,24]],"رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ":[[25,74]],"تَوَفَّنِي مُسْلِمًا وَأَلْحِقْنِي بِالصَّالِحِينَ":[[12,101]],"رَبَّنَا تَقَبَّلْ مِنَّا إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ":[[2,127]],"حِكْمَة":[[2,269]],"تَوْبَةً نَصُوحًا":[[66,8]],"إِنَّا كُلَّ شَيْءٍ خَلَقْنَاهُ بِقَدَرٍ":[[54,49]],"الْأَوَّل":[[57,3]],"الْآخِر":[[57,3]],"الظَّاهِر":[[57,3]],"الْبَاطِن":[[57,3]],"الْوَارِث":[[15,23]],"مَالِكُ الْمُلْك":[[3,26]],"ذُو الْجَلَالِ وَالْإِكْرَام":[[55,27]],"الْبَرّ":[[52,28]],"الْمُتَعَالِ":[[13,9]],"الْقَادِر":[[6,65]],"الْوَلِيّ":[[42,28]],"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ":[[57,3]],"رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي":[[28,16]],"رَبِّ اغْفِرْ وَارْحَمْ وَأَنْتَ خَيْرُ الرَّاحِمِينَ":[[23,118]],"الرِّبَا":[[2,275]],"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا":[[94,5],[94,6]],"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ۝ وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ ۝ وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ":[[93,3],[93,4],[93,5]],"قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللّٰهِ ۚ إِنَّ اللّٰهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا":[[39,53]],"فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ":[[2,152]],"وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ":[[2,186]],"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ":[[50,16]],"وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ":[[57,4]],"قَالَ لَا تَخَافَا ۖ إِنَّنِي مَعَكُمَا أَسْمَعُ وَأَرَىٰ":[[20,46]],"الَّذِينَ إِذَا أَصَابَتْهُم مُّصِيبَةٌ قَالُوا إِنَّا لِلّٰهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ":[[2,156]],"إِنَّمَا أَشْكُو بَثِّي وَحُزْنِي إِلَى اللّٰهِ":[[12,86]],"وَلَا تَيْأَسُوا مِن رَّوْحِ اللّٰهِ":[[12,87]],"فَصَبْرٌ جَمِيلٌ ۖ وَاللّٰهُ الْمُسْتَعَانُ":[[12,18]],"لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ":[[14,7]],"وَإِن تَعُدُّوا نِعْمَةَ اللّٰهِ لَا تُحْصُوهَا":[[16,18]],"وَلْيَعْفُوا وَلْيَصْفَحُوا ۗ أَلَا تُحِبُّونَ أَن يَغْفِرَ اللّٰهُ لَكُمْ":[[24,22]],"ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ فَإِذَا الَّذِي بَيْنَكَ وَبَيْنَهُ عَدَاوَةٌ كَأَنَّهُ وَلِيٌّ حَمِيمٌ":[[41,34]],"وَالْكَاظِمِينَ الْغَيْظَ وَالْعَافِينَ عَنِ النَّاسِ ۗ وَاللّٰهُ يُحِبُّ الْمُحْسِنِينَ":[[3,134]],"فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللّٰهِ":[[42,40]],"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ":[[113,5]],"وَلَا تَتَمَنَّوْا مَا فَضَّلَ اللّٰهُ بِهِ بَعْضَكُمْ عَلَىٰ بَعْضٍ ... وَاسْأَلُوا اللّٰهَ مِن فَضْلِهِ":[[4,32]],"رَبَّنَا اغْفِرْ لَنَا وَلِإِخْوَانِنَا الَّذِينَ سَبَقُونَا بِالْإِيمَانِ وَلَا تَجْعَلْ فِي قُلُوبِنَا غِلًّا لِّلَّذِينَ آمَنُوا":[[59,10]],"وَلَا يَجْرِمَنَّكُمْ شَنَآنُ قَوْمٍ عَلَىٰ أَلَّا تَعْدِلُوا ۚ اعْدِلُوا هُوَ أَقْرَبُ لِلتَّقْوَىٰ":[[5,8]],"عَسَى اللّٰهُ أَن يَجْعَلَ بَيْنَكُمْ وَبَيْنَ الَّذِينَ عَادَيْتُم مِّنْهُم مَّوَدَّةً":[[60,7]],"وَمَن يَتَّقِ اللّٰهَ يَجْعَل لَّهُ مَخْرَجًا ۝ وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ ۚ وَمَن يَتَوَكَّلْ عَلَى اللّٰهِ فَهُوَ حَسْبُهُ":[[65,2],[65,3]],"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً":[[30,21]],"فَلَا تَقُل لَّهُمَا أُفٍّ وَلَا تَنْهَرْهُمَا وَقُل لَّهُمَا قَوْلًا كَرِيمًا":[[17,23]],"وَإِن جَاهَدَاكَ عَلَىٰ أَن تُشْرِكَ بِي ... فَلَا تُطِعْهُمَا ۖ وَصَاحِبْهُمَا فِي الدُّنْيَا مَعْرُوفًا":[[31,15]],"لَّا يَنْهَاكُمُ اللّٰهُ عَنِ الَّذِينَ لَمْ يُقَاتِلُوكُمْ فِي الدِّينِ ... أَن تَبَرُّوهُمْ وَتُقْسِطُوا إِلَيْهِمْ":[[60,8]],"الْمَالُ وَالْبَنُونَ زِينَةُ الْحَيَاةِ الدُّنْيَا ۖ وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِندَ رَبِّكَ ثَوَابًا":[[18,46]],"وَاعْلَمُوا أَنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَأَنَّ اللّٰهَ عِندَهُ أَجْرٌ عَظِيمٌ":[[8,28]],"مَّثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللّٰهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنبُلَةٍ مِّائَةُ حَبَّةٍ":[[2,261]],"قَدْ أَفْلَحَ الْمُؤْمِنُونَ ۝ الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ":[[23,1],[23,2]],"قَدْ أَفْلَحَ مَن تَزَكَّىٰ ۝ وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّىٰ":[[87,14],[87,15]],"وَأَن لَّيْسَ لِلْإِنسَانِ إِلَّا مَا سَعَىٰ ۝ وَأَنَّ سَعْيَهُ سَوْفَ يُرَىٰ":[[53,39],[53,40]],"وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا":[[29,69]],"وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ":[[26,80]],"كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ ۗ وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ الْقِيَامَةِ ۖ فَمَن زُحْزِحَ عَنِ النَّارِ وَأُدْخِلَ الْجَنَّةَ فَقَدْ فَازَ":[[3,185]],"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ ۝ ارْجِعِي إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً ۝ فَادْخُلِي فِي عِبَادِي ۝ وَادْخُلِي جَنَّتِي":[[89,27],[89,28],[89,29],[89,30]],"الْأَخِلَّاءُ يَوْمَئِذٍ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا الْمُتَّقِينَ":[[43,67]],"هُوَ الَّذِي أَنزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ لِيَزْدَادُوا إِيمَانًا مَّعَ إِيمَانِهِمْ":[[48,4]],"وَعَسَىٰ أَن تَكْرَهُوا شَيْئًا وَهُوَ خَيْرٌ لَّكُمْ ۖ وَعَسَىٰ أَن تُحِبُّوا شَيْئًا وَهُوَ شَرٌّ لَّكُمْ ۗ وَاللّٰهُ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ":[[2,216]],"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ ۝ فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ السَّاجِدِينَ":[[15,97],[15,98]],"وَلَا تَخَافِي وَلَا تَحْزَنِي ۖ إِنَّا رَادُّوهُ إِلَيْكِ":[[28,7]],"وَهُزِّي إِلَيْكِ بِجِذْعِ النَّخْلَةِ تُسَاقِطْ عَلَيْكِ رُطَبًا جَنِيًّا ۝ فَكُلِي وَاشْرَبِي وَقَرِّي عَيْنًا":[[19,25],[19,26]],"رَبِّ إِنِّي لِمَا أَنزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ":[[28,24]],"لَقَدْ جَاءَكُمْ رَسُولٌ مِّنْ أَنفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُم بِالْمُؤْمِنِينَ رَءُوفٌ رَّحِيمٌ":[[9,128]],"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ":[[40,60]],"أَمَّن يُجِيبُ الْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ السُّوءَ":[[27,62]],"وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ":[[7,156]],"إِلَّا مَن تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَٰئِكَ يُبَدِّلُ اللّٰهُ سَيِّئَاتِهِمْ حَسَنَاتٍ":[[25,70]],"وَمَن يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللّٰهَ يَجِدِ اللّٰهَ غَفُورًا رَّحِيمًا":[[4,110]],"فَبِمَا رَحْمَةٍ مِّنَ اللّٰهِ لِنتَ لَهُمْ ۖ وَلَوْ كُنتَ فَظًّا غَلِيظَ الْقَلْبِ لَانفَضُّوا مِنْ حَوْلِكَ":[[3,159]],"إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ":[[39,10]],"يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللّٰهَ مَعَ الصَّابِرِينَ":[[2,153]],"قُلْ بِفَضْلِ اللّٰهِ وَبِرَحْمَتِهِ فَبِذَٰلِكَ فَلْيَفْرَحُوا هُوَ خَيْرٌ مِّمَّا يَجْمَعُونَ":[[10,58]],"إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اللّٰهِ لَا نُرِيدُ مِنكُمْ جَزَاءً وَلَا شُكُورًا":[[76,9]],"إِنَّ أَكْرَمَكُمْ عِندَ اللّٰهِ أَتْقَاكُمْ":[[49,13]],"وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا":[[31,18]],"وَعِبَادُ الرَّحْمَٰنِ الَّذِينَ يَمْشُونَ عَلَى الْأَرْضِ هَوْنًا وَإِذَا خَاطَبَهُمُ الْجَاهِلُونَ قَالُوا سَلَامًا":[[25,63]],"وَقُل رَّبِّ زِدْنِي عِلْمًا":[[20,114]],"رَبَّنَا آتِنَا مِن لَّدُنكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا":[[18,10]],"إِنَّمَا الْمُؤْمِنُونَ إِخْوَةٌ فَأَصْلِحُوا بَيْنَ أَخَوَيْكُمْ":[[49,10]],"يَا بُنَيَّ لَا تُشْرِكْ بِاللّٰهِ ۖ إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ":[[31,13]],"قُلْ إِن كُنتُمْ تُحِبُّونَ اللّٰهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللّٰهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ":[[3,31]],"لِّكَيْلَا تَأْسَوْا عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ":[[57,23]],"فَسَوْفَ يَأْتِي اللّٰهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُ":[[5,54]],"لَا إِلَٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ":[[21,87]],"أَنِّي مَسَّنِيَ الضُّرُّ وَأَنتَ أَرْحَمُ الرَّاحِمِينَ":[[21,83]],"رَبِّ اشْرَحْ لِي صَدْرِي ۝ وَيَسِّرْ لِي أَمْرِي ۝ وَاحْلُلْ عُقْدَةً مِّن لِّسَانِي ۝ يَفْقَهُوا قَوْلِي":[[20,25],[20,26],[20,27],[20,28]],"رَبِّ أَوْزِعْنِي أَنْ أَشْكُرَ نِعْمَتَكَ الَّتِي أَنْعَمْتَ عَلَيَّ وَعَلَىٰ وَالِدَيَّ وَأَنْ أَعْمَلَ صَالِحًا تَرْضَاهُ":[[27,19]],"رَّبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا":[[17,24]],"رَبَّنَا هَبْ لَنَا مِنْ أَزْوَاجِنَا وَذُرِّيَّاتِنَا قُرَّةَ أَعْيُنٍ وَاجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا":[[25,74]],"رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنتَ خَيْرُ الْوَارِثِينَ":[[21,89]],"الرَّحْمَٰنُ الرَّحِيمُ":[[1,1]],"الْوَكِيلُ":[[3,173]],"الرَّزَّاقُ":[[51,58]],"الْوَدُودُ":[[85,14]],"الْجَبَّارُ":[[59,23]],"السَّلَامُ":[[59,23]],"لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ ۖ يَغْفِرُ اللّٰهُ لَكُمْ":[[12,92]],"كَلَّا ۖ إِنَّ مَعِيَ رَبِّي سَيَهْدِينِ":[[26,62]],"رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَىٰ ۖ قَالَ أَوَلَمْ تُؤْمِن ۖ قَالَ بَلَىٰ وَلَٰكِن لِّيَطْمَئِنَّ قَلْبِي":[[2,260]],"أَفَلَا يَنظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ ۝ وَإِلَى السَّمَاءِ كَيْفَ رُفِعَتْ":[[88,17],[88,18]],"وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ":[[2,45]],"هُنَّ لِبَاسٌ لَكُمْ وَأَنْتُمْ لِبَاسٌ لَهُنَّ":[[2,187]],"رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا":[[3,8]],"وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ":[[3,135]],"وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ":[[3,139]],"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَآيَاتٍ لِأُولِي الْأَلْبَابِ":[[3,190]],"فَعَسَىٰ أَنْ تَكْرَهُوا شَيْئًا وَيَجْعَلَ اللَّهُ فِيهِ خَيْرًا كَثِيرًا":[[4,19]],"وَالصُّلْحُ خَيْرٌ":[[4,128]],"كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَىٰ أَنْفُسِكُمْ":[[4,135]],"كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ الرَّحْمَةَ":[[6,54]],"وَلِبَاسُ التَّقْوَىٰ ذَٰلِكَ خَيْرٌ":[[7,26]],"وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ":[[7,43]],"خُذِ الْعَفْوَ وَأْمُرْ بِالْعُرْفِ وَأَعْرِضْ عَنِ الْجَاهِلِينَ":[[7,199]],"إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ":[[7,201]],"وَمَا مِنْ دَابَّةٍ فِي الْأَرْضِ إِلَّا عَلَى اللَّهِ رِزْقُهَا":[[11,6]],"إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ":[[11,114]],"لَا تَقْصُصْ رُؤْيَاكَ عَلَىٰ إِخْوَتِكَ فَيَكِيدُوا لَكَ كَيْدًا":[[12,5]],"إِذْ قَالُوا لَيُوسُفُ وَأَخُوهُ أَحَبُّ إِلَىٰ أَبِينَا مِنَّا":[[12,8]],"وَفَوْقَ كُلِّ ذِي عِلْمٍ عَلِيمٌ":[[12,76]],"لَا تَثْرِيبَ عَلَيْكُمُ الْيَوْمَ يَغْفِرُ اللَّهُ لَكُمْ":[[12,92]],"إِنَّ اللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُوا مَا بِأَنْفُسِهِمْ":[[13,11]],"رَبِّ اجْعَلْنِي مُقِيمَ الصَّلَاةِ وَمِنْ ذُرِّيَّتِي رَبَّنَا وَتَقَبَّلْ دُعَاءِ":[[14,40]],"فَاسْأَلُوا أَهْلَ الذِّكْرِ إِنْ كُنْتُمْ لَا تَعْلَمُونَ":[[16,43]],"وَأَوْحَىٰ رَبُّكَ إِلَى النَّحْلِ":[[16,68]],"مَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ أَوْ أُنْثَىٰ وَهُوَ مُؤْمِنٌ فَلَنُحْيِيَنَّهُ حَيَاةً طَيِّبَةً":[[16,97]],"ادْعُ إِلَىٰ سَبِيلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ":[[16,125]],"وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا":[[17,37]],"وَقُلْ لِعِبَادِي يَقُولُوا الَّتِي هِيَ أَحْسَنُ":[[17,53]],"وَاصْبِرْ نَفْسَكَ مَعَ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ":[[18,28]],"قَالَ سَلَامٌ عَلَيْكَ سَأَسْتَغْفِرُ لَكَ رَبِّي":[[19,47]],"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَيَجْعَلُ لَهُمُ الرَّحْمَٰنُ وُدًّا":[[19,96]],"وَمَنْ أَعْرَضَ عَنْ ذِكْرِي فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا":[[20,124]],"وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ وَاصْطَبِرْ عَلَيْهَا":[[20,132]],"فَإِنَّهَا لَا تَعْمَى الْأَبْصَارُ وَلَٰكِنْ تَعْمَى الْقُلُوبُ الَّتِي فِي الصُّدُورِ":[[22,46]],"قُلْ لِلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ ذَٰلِكَ أَزْكَىٰ لَهُمْ":[[24,30]],"اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ":[[24,35]],"فَإِذَا دَخَلْتُمْ بُيُوتًا فَسَلِّمُوا عَلَىٰ أَنْفُسِكُمْ تَحِيَّةً مِنْ عِنْدِ اللَّهِ مُبَارَكَةً طَيِّبَةً":[[24,61]],"فَجَاءَتْهُ إِحْدَاهُمَا تَمْشِي عَلَى اسْتِحْيَاءٍ":[[28,25]],"لَا تَفْرَحْ إِنَّ اللَّهَ لَا يُحِبُّ الْفَرِحِينَ":[[28,76]],"وَابْتَغِ فِيمَا آتَاكَ اللَّهُ الدَّارَ الْآخِرَةَ وَلَا تَنْسَ نَصِيبَكَ مِنَ الدُّنْيَا":[[28,77]],"تِلْكَ الدَّارُ الْآخِرَةُ نَجْعَلُهَا لِلَّذِينَ لَا يُرِيدُونَ عُلُوًّا فِي الْأَرْضِ وَلَا فَسَادًا":[[28,83]],"أَحَسِبَ النَّاسُ أَنْ يُتْرَكُوا أَنْ يَقُولُوا آمَنَّا وَهُمْ لَا يُفْتَنُونَ":[[29,2]],"إِنَّ الصَّلَاةَ تَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ وَلَذِكْرُ اللَّهِ أَكْبَرُ":[[29,45]],"وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافُ أَلْسِنَتِكُمْ وَأَلْوَانِكُمْ":[[30,22]],"وَوَصَّيْنَا الْإِنْسَانَ بِوَالِدَيْهِ حَمَلَتْهُ أُمُّهُ وَهْنًا عَلَىٰ وَهْنٍ… أَنِ اشْكُرْ لِي وَلِوَالِدَيْكَ":[[31,14]],"لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ":[[33,21]],"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا":[[33,41],[33,42]],"إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ يَا أَيُّهَا الَّذِينَ آمَنُوا صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا":[[33,56]],"يَا أَيُّهَا النَّاسُ أَنْتُمُ الْفُقَرَاءُ إِلَى اللَّهِ وَاللَّهُ هُوَ الْغَنِيُّ الْحَمِيدُ":[[35,15]],"أَلَيْسَ اللَّهُ بِكَافٍ عَبْدَهُ":[[39,36]],"وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ":[[40,44]],"وَلَمَنْ صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنْ عَزْمِ الْأُمُورِ":[[42,43]],"يَهَبُ لِمَنْ يَشَاءُ إِنَاثًا وَيَهَبُ لِمَنْ يَشَاءُ الذُّكُورَ… وَيَجْعَلُ مَنْ يَشَاءُ عَقِيمًا":[[42,49],[42,50]],"نَحْنُ قَسَمْنَا بَيْنَهُمْ مَعِيشَتَهُمْ فِي الْحَيَاةِ الدُّنْيَا":[[43,32]],"حَمَلَتْهُ أُمُّهُ كُرْهًا وَوَضَعَتْهُ كُرْهًا":[[46,15]],"يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِنَ الظَّنِّ إِنَّ بَعْضَ الظَّنِّ إِثْمٌ":[[49,12]],"وَفِي أَنْفُسِكُمْ أَفَلَا تُبْصِرُونَ":[[51,21]],"كُلُّ مَنْ عَلَيْهَا فَانٍ وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْإِكْرَامِ":[[55,26],[55,27]],"يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ":[[58,11]],"وَيُؤْثِرُونَ عَلَىٰ أَنْفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌ":[[59,9]],"وَإِنْ تَعْفُوا وَتَصْفَحُوا وَتَغْفِرُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ":[[64,14]],"فَاتَّقُوا اللَّهَ مَا اسْتَطَعْتُمْ":[[64,16]],"وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ":[[65,3]],"يَا أَيُّهَا الَّذِينَ آمَنُوا قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ نَارًا":[[66,6]],"الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا":[[67,2]],"مَا تَرَىٰ فِي خَلْقِ الرَّحْمَٰنِ مِنْ تَفَاوُتٍ فَارْجِعِ الْبَصَرَ هَلْ تَرَىٰ مِنْ فُطُورٍ":[[67,3]],"فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا":[[71,10],[71,11]],"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ":[[84,6]],"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ":[[90,4]],"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي أَحْسَنِ تَقْوِيمٍ":[[95,4]],"أَلْهَاكُمُ التَّكَاثُرُ حَتَّىٰ زُرْتُمُ الْمَقَابِرَ":[[102,1],[102,2]],"الَّذِي أَطْعَمَهُمْ مِنْ جُوعٍ وَآمَنَهُمْ مِنْ خَوْفٍ":[[106,4]],"وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ":[[54,17]],"وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ":[[98,5]],"وَفِي ذَٰلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُونَ":[[83,26]],"سَابِقُوا إِلَىٰ مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ":[[57,21]],"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ":[[96,14]],"قَالَتْ نَمْلَةٌ يَا أَيُّهَا النَّمْلُ ادْخُلُوا مَسَاكِنَكُمْ":[[27,18]],"رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ":[[37,100]],"التَّوَّابُ":[[2,37]],"حَافِظُوا عَلَى الصَّلَوَاتِ وَالصَّلَاةِ الْوُسْطَىٰ وَقُومُوا لِلَّهِ قَانِتِينَ":[[2,238]],"إِنَّنِي أَنَا اللَّهُ لَا إِلَٰهَ إِلَّا أَنَا فَاعْبُدْنِي وَأَقِمِ الصَّلَاةَ لِذِكْرِي":[[20,14]],"إِنَّ الْإِنْسَانَ خُلِقَ هَلُوعًا إِذَا مَسَّهُ الشَّرُّ جَزُوعًا وَإِذَا مَسَّهُ الْخَيْرُ مَنُوعًا إِلَّا الْمُصَلِّينَ الَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَائِمُونَ":[[70,19],[70,20],[70,21],[70,22],[70,23]],"أَقِمِ الصَّلَاةَ لِدُلُوكِ الشَّمْسِ إِلَىٰ غَسَقِ اللَّيْلِ وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا":[[17,78]],"إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَوْقُوتًا":[[4,103]],"يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ":[[22,77]],"إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ":[[2,222]],"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نُودِيَ لِلصَّلَاةِ مِنْ يَوْمِ الْجُمُعَةِ فَاسْعَوْا إِلَىٰ ذِكْرِ اللَّهِ وَذَرُوا الْبَيْعَ ذَٰلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ فَإِذَا قُضِيَتِ الصَّلَاةُ فَانْتَشِرُوا فِي الْأَرْضِ وَابْتَغُوا مِنْ فَضْلِ اللَّهِ وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ":[[62,9],[62,10]],"وَإِذَا رَأَوْا تِجَارَةً أَوْ لَهْوًا انْفَضُّوا إِلَيْهَا وَتَرَكُوكَ قَائِمًا قُلْ مَا عِنْدَ اللَّهِ خَيْرٌ مِنَ اللَّهْوِ وَمِنَ التِّجَارَةِ وَاللَّهُ خَيْرُ الرَّازِقِينَ":[[62,11]],"وَمِنَ اللَّيْلِ فَتَهَجَّدْ بِهِ نَافِلَةً لَكَ عَسَىٰ أَنْ يَبْعَثَكَ رَبُّكَ مَقَامًا مَحْمُودًا":[[17,79]],"تَتَجَافَىٰ جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ":[[32,16]],"كَانُوا قَلِيلًا مِنَ اللَّيْلِ مَا يَهْجَعُونَ وَبِالْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ":[[51,17],[51,18]],"أَمَّنْ هُوَ قَانِتٌ آنَاءَ اللَّيْلِ سَاجِدًا وَقَائِمًا يَحْذَرُ الْآخِرَةَ وَيَرْجُو رَحْمَةَ رَبِّهِ قُلْ هَلْ يَسْتَوِي الَّذِينَ يَعْلَمُونَ وَالَّذِينَ لَا يَعْلَمُونَ إِنَّمَا يَتَذَكَّرُ أُولُو الْأَلْبَابِ":[[39,9]],"وَهُوَ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِبَاسًا وَالنَّوْمَ سُبَاتًا وَجَعَلَ النَّهَارَ نُشُورًا":[[25,47]],"فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ":[[6,96]],"وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ وَلَا يَزِيدُ الظَّالِمِينَ إِلَّا خَسَارًا":[[17,82]],"يَا أَيُّهَا النَّاسُ قَدْ جَاءَتْكُمْ مَوْعِظَةٌ مِنْ رَبِّكُمْ وَشِفَاءٌ لِمَا فِي الصُّدُورِ وَهُدًى وَرَحْمَةٌ لِلْمُؤْمِنِينَ":[[10,57]],"كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوا آيَاتِهِ وَلِيَتَذَكَّرَ أُولُو الْأَلْبَابِ":[[38,29]],"أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ أَمْ عَلَىٰ قُلُوبٍ أَقْفَالُهَا":[[47,24]],"لَوْ أَنْزَلْنَا هَٰذَا الْقُرْآنَ عَلَىٰ جَبَلٍ لَرَأَيْتَهُ خَاشِعًا مُتَصَدِّعًا مِنْ خَشْيَةِ اللَّهِ وَتِلْكَ الْأَمْثَالُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ":[[59,21]],"اللَّهُ نَزَّلَ أَحْسَنَ الْحَدِيثِ كِتَابًا مُتَشَابِهًا مَثَانِيَ تَقْشَعِرُّ مِنْهُ جُلُودُ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ ثُمَّ تَلِينُ جُلُودُهُمْ وَقُلُوبُهُمْ إِلَىٰ ذِكْرِ اللَّهِ ذَٰلِكَ هُدَى اللَّهِ يَهْدِي بِهِ مَنْ يَشَاءُ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ":[[39,23]],"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ":[[8,2]],"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ بَدَأَ الْخَلْقَ ثُمَّ اللَّهُ يُنْشِئُ النَّشْأَةَ الْآخِرَةَ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ":[[29,20]],"وَإِذَا ضَرَبْتُمْ فِي الْأَرْضِ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَقْصُرُوا مِنَ الصَّلَاةِ":[[4,101]],"يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ":[[2,185]],"قُلْ لَنْ يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا هُوَ مَوْلَانَا وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ":[[9,51]],"وَالَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ وَإِذَا مَا غَضِبُوا هُمْ يَغْفِرُونَ":[[42,37]],"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَاخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ":[[15,88]],"مَا يَكُونُ مِنْ نَجْوَىٰ ثَلَاثَةٍ إِلَّا هُوَ رَابِعُهُمْ":[[58,7]],"وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا تَفْعَلُونَ":[[42,25]],"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَىٰ قَالَ أَوَلَمْ تُؤْمِنْ قَالَ بَلَىٰ وَلَٰكِنْ لِيَطْمَئِنَّ قَلْبِي":[[2,260]],"سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ":[[41,53]],"وَلَقَدْ آتَيْنَا لُقْمَانَ الْحِكْمَةَ أَنِ اشْكُرْ لِلَّهِ وَمَنْ يَشْكُرْ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِ وَمَنْ كَفَرَ فَإِنَّ اللَّهَ غَنِيٌّ حَمِيدٌ":[[31,12]],"قَالَ وَمَنْ يَقْنَطُ مِنْ رَحْمَةِ رَبِّهِ إِلَّا الضَّالُّونَ":[[15,56]],"أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ":[[2,214]],"وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ":[[2,165]],"إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ وَإِيتَاءِ ذِي الْقُرْبَىٰ وَيَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ وَالْبَغْيِ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ":[[16,90]],"إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَاللَّهُ عِنْدَهُ أَجْرٌ عَظِيمٌ":[[64,15]],"وَلَا تَنْسَوُا الْفَضْلَ بَيْنَكُمْ":[[2,237]],"لِيُنْفِقْ ذُو سَعَةٍ مِنْ سَعَتِهِ وَمَنْ قُدِرَ عَلَيْهِ رِزْقُهُ فَلْيُنْفِقْ مِمَّا آتَاهُ اللَّهُ لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا مَا آتَاهَا سَيَجْعَلُ اللَّهُ بَعْدَ عُسْرٍ يُسْرًا":[[65,7]],"وَلَا تَجْعَلْ يَدَكَ مَغْلُولَةً إِلَىٰ عُنُقِكَ وَلَا تَبْسُطْهَا كُلَّ الْبَسْطِ فَتَقْعُدَ مَلُومًا مَحْسُورًا":[[17,29]],"كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ ثُمَّ إِلَيْنَا تُرْجَعُونَ":[[29,57]],"قُلْ إِنَّ الْمَوْتَ الَّذِي تَفِرُّونَ مِنْهُ فَإِنَّهُ مُلَاقِيكُمْ ثُمَّ تُرَدُّونَ إِلَىٰ عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ":[[62,8]],"وَيَوْمَ يَعَضُّ الظَّالِمُ عَلَىٰ يَدَيْهِ يَقُولُ يَا لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلًا يَا وَيْلَتَىٰ لَيْتَنِي لَمْ أَتَّخِذْ فُلَانًا خَلِيلًا":[[25,27],[25,28]],"فَاصْفَحِ الصَّفْحَ الْجَمِيلَ":[[15,85]],"يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا":[[66,8]],"وَاصْبِرْ وَمَا صَبْرُكَ إِلَّا بِاللَّهِ":[[16,127]],"فَاصْبِرْ صَبْرًا جَمِيلًا":[[70,5]],"وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُنْ مِنَ الْغَافِلِينَ":[[7,205]],"وَتَوَكَّلْ عَلَى الْحَيِّ الَّذِي لَا يَمُوتُ":[[25,58]],"أَلَا إِنَّ أَوْلِيَاءَ اللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ":[[10,62]],"فَلَا تُزَكُّوا أَنْفُسَكُمْ هُوَ أَعْلَمُ بِمَنِ اتَّقَىٰ":[[53,32]],"قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ":[[6,162]],"نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ":[[15,49]],"وَوَصَّيْنَا الْإِنْسَانَ بِوَالِدَيْهِ حُسْنًا وَإِنْ جَاهَدَاكَ لِتُشْرِكَ بِي مَا لَيْسَ لَكَ بِهِ عِلْمٌ فَلَا تُطِعْهُمَا إِلَيَّ مَرْجِعُكُمْ فَأُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ":[[29,8]],"الحَمْدُ لِلّٰهِ رَبِّ العَالَمِينَ":[[1,2]],"الرَّحْمٰنِ الرَّحِيمِ":[[1,3]],"مَالِكِ يَوْمِ الدِّينِ":[[1,4]],"اهْدِنَا الصِّرَاطَ المُسْتَقِيمَ":[[1,6]],"صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ المَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ":[[1,7]],"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ":[[112,4]],"قُلْ أَعُوذُ بِرَبِّ الفَلَقِ":[[113,1]],"مِنْ شَرِّ مَا خَلَقَ":[[113,2]],"وَمِنْ شَرِّ غَاسِقٍ إِذَا وَقَبَ":[[113,3]],"وَمِنْ شَرِّ النَّفَّاثَاتِ فِي العُقَدِ":[[113,4]],"وَمِنْ شَرِّ حَاسِدٍ إِذَا حَسَدَ":[[113,5]],"قُلْ أَعُوذُ بِرَبِّ النَّاسِ":[[114,1]],"مَلِكِ النَّاسِ":[[114,2]],"إِلٰهِ النَّاسِ":[[114,3]],"مِنْ شَرِّ الوَسْوَاسِ الخَنَّاسِ":[[114,4]],"الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ":[[114,5]],"مِنَ الجِنَّةِ وَالنَّاسِ":[[114,6]],"اللّٰهُ لَا إِلٰهَ إِلَّا هُوَ الحَيُّ القَيُّومُ":[[2,255]],"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الأَرْضِ":[[2,255]],"مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ":[[2,255]],"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ":[[2,255]],"وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ":[[2,255]],"وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالأَرْضَ":[[2,255]],"وَلَا يَئُودُهُ حِفْظُهُمَا":[[2,255]],"وَهُوَ العَلِيُّ العَظِيمُ":[[2,255]],"وَالعَصْرِ":[[103,1]],"إِنَّ الإِنْسَانَ لَفِي خُسْرٍ":[[103,2]],"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالحَقِّ وَتَوَاصَوْا بِالصَّبْرِ":[[103,3]],"إِنَّا أَعْطَيْنَاكَ الكَوْثَرَ":[[108,1]],"فَصَلِّ لِرَبِّكَ وَانْحَرْ":[[108,2]],"إِنَّ شَانِئَكَ هُوَ الأَبْتَرُ":[[108,3]],"إِذَا جَاءَ نَصْرُ اللّٰهِ وَالفَتْحُ":[[110,1]],"وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللّٰهِ أَفْوَاجًا":[[110,2]],"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا":[[110,3]]}