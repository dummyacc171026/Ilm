{"id":"94","v":[{"s":94,"n":1,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","tr":"alam nashraḥ laka ṣadrak","fr":"N'avons-Nous pas ouvert pour toi ta poitrine ?","d":3.58},{"s":94,"n":2,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","tr":"wa-waḍaʿnā ʿanka wizrak","fr":"Et ne t'avons-Nous pas déchargé du fardeau","d":4.39},{"s":94,"n":3,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","tr":"alladhī anqaḍa ẓahrak","fr":"qui accablait ton dos ?","d":5.54},{"s":94,"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","tr":"warafaʿnā laka dhikrak","fr":"Et exalté pour toi ta renommée ?","d":3.55},{"s":94,"n":5,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","tr":"fa-inna maʿa l-ʿusri yusrā","fr":"A côté de la difficulté est, certes, une facilité !","d":4.47},{"s":94,"n":6,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","tr":"inna maʿa l-ʿusri yusrā","fr":"A côté de la difficulté est, certes, une facilité !","d":4.15},{"s":94,"n":7,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","tr":"fa-idhā faraghta fa-nṣab","fr":"Quand tu te libères, donc, lève-toi,","d":4.21},{"s":94,"n":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","tr":"wa-ilā rabbika fa-rghab","fr":"et à ton Seigneur aspire.","d":4.23}]}