{"id":"101","v":[{"s":101,"n":1,"ar":"ٱلْقَارِعَةُ","tr":"al-qāriʿah","fr":"Le fracas !","d":2.32},{"s":101,"n":2,"ar":"مَا ٱلْقَارِعَةُ","tr":"mā l-qāriʿah","fr":"Qu'est-ce que le fracas ?","d":2.3},{"s":101,"n":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","tr":"wa-mā adrāka mā l-qāriʿah","fr":"Et qui te dira ce qu'est le fracas ?","d":5.59},{"s":101,"n":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","tr":"yawma yakūnu n-nāsu kālfarāshi l-mabthūth","fr":"C'est le jour où les gens seront comme des papillons éparpillés,","d":7.78},{"s":101,"n":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","tr":"wa-takūnu l-jibālu kālʿihni l-manfūsh","fr":"et les montagnes comme de la laine cardée ;","d":7.6},{"s":101,"n":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","tr":"fa-ammā man thaqulat mawāzīnuh","fr":"quant à celui dont la balance sera lourde","d":5.72},{"s":101,"n":7,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","tr":"fa-huwa fī ʿīshatin rāḍiyah","fr":"il sera dans une vie agréable ;","d":3.87},{"s":101,"n":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","tr":"wa-ammā man khaffat mawāzīnuh","fr":"et quant à celui dont la balance sera légère,","d":5.07},{"s":101,"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","tr":"fa-ummuhu hāwiyah","fr":"sa mère [destination] est un abîme très profond.","d":3.47},{"s":101,"n":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","tr":"wa-mā adrāka mā hiyah","fr":"Et qui te dira ce que c'est ?","d":4.49},{"s":101,"n":11,"ar":"نَارٌ حَامِيَةٌۢ","tr":"nārun ḥāmiyah","fr":"C'est un Feu ardent.","d":5.04}]}