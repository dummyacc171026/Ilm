{"id":"96","v":[{"s":96,"n":1,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","tr":"iqraʾ bismi rabbika lladhī khalaq","fr":"Lis, au nom de ton Seigneur qui a créé,","d":4.36},{"s":96,"n":2,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","tr":"khalaqa l-insāna min ʿalaq","fr":"qui a créé l'homme d'une adhérence.","d":4.44},{"s":96,"n":3,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","tr":"iqraʾ wa-rabbuka l-akram","fr":"Lis ! Ton Seigneur est le Très Noble,","d":3.4},{"s":96,"n":4,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","tr":"alladhī ʿallama bi-l-qalam","fr":"qui a enseigné par la plume [le calame],","d":3.42},{"s":96,"n":5,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","tr":"ʿallama l-insāna mā lam yaʿlam","fr":"a enseigné à l'homme ce qu'il ne savait pas.","d":5.04},{"s":96,"n":6,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","tr":"kallā inna l-insāna la-yaṭghā","fr":"Prenez-garde ! Vraiment l'homme devient rebelle,","d":7.11},{"s":96,"n":7,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","tr":"an raʾāhu staghnā","fr":"dès qu'il estime qu'il peut se suffire à lui-même (à cause de sa richesse).","d":2.95},{"s":96,"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","tr":"inna ilā rabbika r-rujʿā","fr":"Mais, c'est vers ton Seigneur qu'est le retour.","d":4.39},{"s":96,"n":9,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","tr":"araʾayta lladhī yanhā","fr":"As-tu vu celui qui interdit","d":3.24},{"s":96,"n":10,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","tr":"ʿabdan idhā ṣallā","fr":"à un serviteur d'Allah [Muhammad] de célébrer la Salât ?","d":3.03},{"s":96,"n":11,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","tr":"araʾayta in kāna ʿalā l-hudā","fr":"Vois-tu s'il est sur la bonne voie,","d":4.44},{"s":96,"n":12,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","tr":"aw amara bi-t-taqwā","fr":"ou s'il ordonne la piété ?","d":2.93},{"s":96,"n":13,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","tr":"araʾayta in kadhdhaba wa-tawallā","fr":"Vois-tu s'il dément et tourne le dos ?","d":4.57},{"s":96,"n":14,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","tr":"alam yaʿlam bi-anna llāha yarā","fr":"Ne sait-il pas que vraiment Allah voit ?","d":5.59},{"s":96,"n":15,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","tr":"kallā laʾin lam yantahi lanasfaʿan bi-n-nāṣiyah","fr":"Mais non ! S'il ne cesse pas, Nous le saisirons certes, par le toupet,","d":8.7},{"s":96,"n":16,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","tr":"nāṣiyatin kādhibatin khāṭiʾah","fr":"le toupet d'un menteur, d'un pécheur.","d":4.65},{"s":96,"n":17,"ar":"فَلْيَدْعُ نَادِيَهُۥ","tr":"falyadʿu nādiyah","fr":"Qu'il appelle donc son assemblée.","d":2.53},{"s":96,"n":18,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","tr":"sanadʿu z-zabāniyah","fr":"Nous appellerons les gardiens [de l'Enfer].","d":2.9},{"s":96,"n":19,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","tr":"kallā lā tuṭiʿhu wa-sjud wa-qtarib","fr":"Non ! Ne lui obéis pas ; mais prosterne-toi et rapproche-toi.","d":6.03}]}